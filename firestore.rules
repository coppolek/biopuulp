rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /pages/{pageId} {
      allow read: if true;
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || request.auth.token.email == "coppolek@gmail.com");
      allow update: if request.auth != null && ((resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) || request.auth.token.email == "coppolek@gmail.com");
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == "coppolek@gmail.com");
    }

    match /analytics/{pageId} {
      allow read: if request.auth != null && (get(/databases/$(database)/documents/pages/$(pageId)).data.userId == request.auth.uid || request.auth.token.email == "coppolek@gmail.com");
      allow create, update: if request.auth != null && (get(/databases/$(database)/documents/pages/$(pageId)).data.userId == request.auth.uid || request.auth.token.email == "coppolek@gmail.com");
    }

    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, delete: if request.auth != null && (get(/databases/$(database)/documents/pages/$(resource.data.pageId)).data.userId == request.auth.uid || request.auth.token.email == "coppolek@gmail.com");
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == "coppolek@gmail.com";
    }

    match /shortLinks/{linkId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if true;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
